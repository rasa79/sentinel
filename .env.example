# Sentinel environment variable reference (D14).
# Copy to `.env` for local overrides. NEVER commit real secrets: this file documents the
# variable names only. The base/defaults live in config.yaml; these env vars override them.
# Precedence (highest -> lowest): shell env vars (SENTINEL_*) > .env file > config.yaml > defaults.
# Nested config keys use `__` as the delimiter (e.g. SENTINEL_DATABASE__URL for database.url).

# ---- LLM client (llm.*) ----
# Provider selection: convenience passthrough with NO SENTINEL_ prefix. Read by the config
# preprocessor from BOTH the shell environment and this .env file; it always wins.
LLM_PROVIDER=ollama
# Equivalent explicit form (takes the SENTINEL_ prefix; same field, LLM_PROVIDER wins if both set).
# SENTINEL_LLM__PROVIDER=ollama
SENTINEL_LLM__MODEL=phi4-mini
SENTINEL_LLM__BASE_URL=http://localhost:11434/v1
# Name of the env var that holds the actual cloud key (read by the provider factory).
SENTINEL_LLM__API_KEY_ENV=OPENAI_API_KEY
SENTINEL_LLM__TEMPERATURE=0.0

# ---- Embeddings (embeddings.*) ----
SENTINEL_EMBEDDINGS__MODEL_NAME=all-MiniLM-L6-v2

# ---- Data store (database.*) ----
SENTINEL_DATABASE__URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# ---- Observability sources ----
SENTINEL_LOKI__URL=http://localhost:3100
SENTINEL_PROMETHEUS__URL=http://localhost:9090

# ---- Remediation (remediation.*) ----
# JSON list values override the yaml list wholesale when set.
SENTINEL_REMEDIATION__ALLOWED_ACTIONS=["restart_service","rollback_deploy","scale_replicas","no_action"]
SENTINEL_REMEDIATION__ALLOWED_SERVICES=["orders","payments","inventory"]
SENTINEL_REMEDIATION__DRY_RUN=true
SENTINEL_REMEDIATION__CONFIDENCE_THRESHOLD=0.7

# ---- Verification loop (verification.*) ----
SENTINEL_VERIFICATION__DELAY_SECONDS=30
SENTINEL_VERIFICATION__ATTEMPTS=3

# ---- RAG retrieval (rag.*) ----
SENTINEL_RAG__TOP_K=3
SENTINEL_RAG__MIN_SCORE=0.3

# ---- Provider-specific secrets (never commit real values) ----
# Unprefixed secrets are tolerated (the root settings model is extra="ignore"), so they may live
# in .env without a SENTINEL_ prefix. Only the var named by SENTINEL_LLM__API_KEY_ENV is actually
# read; the rest are carried but unused.
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# Optional: LangSmith tracing/eval upload; a no-op without this set (limitation L6).
# LANGSMITH_API_KEY=
